# ===== Обязательно =====
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Твой Telegram ID (бот скажет его на /start)
OWNER_ID=
# Ключ AI с console.anthropic.com
ANTHROPIC_API_KEY=

# ===== Необязательно =====
MORNING_TIME=07:00
EVENING_TIME=21:30
CHECKIN_TIMES=12:30,17:00
LEAD_MINUTES=60,15
SLEEP_HOURS=7.5
QUIZ_TIME=19:30
WEEKLY_TIME=20:00
PROTEIN_GOAL=150
KCAL_GOAL=3000
READY_MINUTES=30
ARRIVE_BUFFER=5
# CLAUDE_MODEL=claude-sonnet-5-5

# Личное (адреса, профиль, экзамен) лежит в my_config.json — он есть только у тебя на ноуте.

# Автообновление с GitHub (по умолчанию включено). Выключить: AUTO_UPDATE=0
# GITHUB_REPO=joinfot/lingofy-tg
# GITHUB_SUBDIR=jarvis
